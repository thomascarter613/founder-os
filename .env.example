# Founder Decision OS environment template
# Copy values into a local .env or .env.local file as needed.

# Application identity
APP_NAME=founder-decision-os
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info

# Canonical PostgreSQL or Supabase database connection
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54322
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# Supabase project wiring
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
SUPABASE_PROJECT_REF=local-dev
SUPABASE_STORAGE_BUCKET_EVIDENCE=evidence
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=attachments

# Semantic memory defaults
VECTOR_EMBEDDING_PROVIDER=openai
VECTOR_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_EMBEDDING_DIMENSIONS=1536

# Optional AI provider credentials
OPENAI_API_KEY=replace-with-openai-api-key

# Optional Qdrant runtime configuration
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=founder-decision-os-memory

# Optional worker tuning
AI_WORKER_CONCURRENCY=2
QDRANT_SYNC_BATCH_SIZE=100
EMBEDDING_BATCH_SIZE=50

# Non-negotiable feature flags
ENABLE_QDRANT=false
ENABLE_AI_WORKER=false
ENABLE_REPORT_GENERATION=false
ENABLE_WEB_APP=false
ENABLE_SUPABASE_STORAGE=true
ENABLE_PGVECTOR=true
